<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.andmed.sing-box</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BIN__</string>
		<string>run</string>
		<string>-c</string>
		<string>client.json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/code/proxy/sing-box</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/sing-box.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/sing-box.log</string>
</dict>
</plist>
